# Provider: anthropic | openai | offline (mock). Leave empty to pick by available key.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
# Required when using OpenAI, for example: gpt-5-mini
OPENAI_MODEL=

# Comma-separated origins allowed on upload and document routes (the frontend).
# Bot routes use each bot's allowed_origins from app/bots.py instead.
CORS_ORIGINS=http://localhost:3010
# Where the sample site lives. The bot's "Talk to a human" link points at its /contact page.
PUBLIC_SITE_URL=http://localhost:3010
# Set to true behind Cloud Run or another proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Local defaults. PUBLIC_DEMO=true switches to 5 MB / 25 pages, 10 live questions
# per IP per hour, 300 per day, and a 1 hour document lifetime.
PUBLIC_DEMO=false
MAX_UPLOAD_MB=20
MAX_PAGES=300
ASK_RATE_LIMIT_PER_MINUTE=20
LIVE_QUESTIONS_PER_IP_PER_HOUR=0
LIVE_QUESTIONS_PER_DAY=0
DOCUMENT_TTL_SECONDS=0
FALLBACK_TO_MOCK=true

# Booking receptionist (the "kingsway" bot). mock uses a built-in weekly schedule.
# http calls the business's booking system, for example http://localhost:3030
BOOKING_PROVIDER=mock
BOOKING_API_URL=
BOOKING_TIMEOUT_SECONDS=8
